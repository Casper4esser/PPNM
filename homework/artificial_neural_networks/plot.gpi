set terminal svg background "white" size 800,600 font "Arial,14"
set output 'plot.svg'

set title 'Kunstigt Neuralt Netværk: Interpolation'
set xlabel 'x'
set ylabel 'y'
set grid

set key bottom left

plot 'data.txt' using 1:3 with lines lw 3 lc rgb 'black' title 'Eksakt funktion g(x)', \
     'data.txt' using 1:2 with lines lw 2 lc rgb 'red' dashtype 2 title 'ANN Approksimation'