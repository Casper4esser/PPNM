set terminal svg background "white" size 800,600
set output 'damped.svg'
set title 'Damped Pendulum'
set xlabel 'Time (t)'
set ylabel 'Values'
set grid
plot 'damped.txt' using 1:2 with linespoints pt 7 ps 0.5 title 'Angle (theta)', \
     'damped.txt' using 1:3 with linespoints pt 7 ps 0.5 title 'Angular velocity'