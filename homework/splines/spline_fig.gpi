set terminal svg background "white" size 800,600
set output "spline_fig.svg"

set title "Linear Spline Interpolation og Integral af cos(x)" font ",14"
set xlabel "z"
set ylabel "Værdi"

set grid 

set style line 1 lc rgb "blue" lw 2         # Tyk blå linje til splinen
set style line 2 lc rgb "red" lw 2 dt 2     # Tyk rød, stiplet linje til integralet
set style line 3 lc rgb "black" pt 7 ps 0.8 # Sorte prikker til de faktiske datapunkter

plot "out.txt" using 1:2 with lines ls 1 title "Linear Spline f(z)", \
     "out.txt" using 1:3 with lines ls 2 title "Integral F(z)", \
     cos(x) with points ls 3 title "Originale punkter (cos(x))"