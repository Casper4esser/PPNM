set terminal svg size 800, 600 background "white"
set output "mc_convergence.svg"

set title "Monte Carlo Integration Error Scaling (Unit Circle)"
set xlabel "Number of points (N)"
set ylabel "Error"
set logscale xy
set grid

plot "mc_error.txt" using 1:2 with linespoints lw 2 lc "red" title "Actual Error", \
     "mc_error.txt" using 1:3 with linespoints lw 2 lc "blue" title "Estimated Error", \
     "mc_error.txt" using 1:4 with lines dashtype 2 lw 2 lc "black" title "1 / sqrt(N) scaling"